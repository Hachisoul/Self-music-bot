# Required: your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: only needed for Spotify links (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: a server (guild) ID to sync slash commands to instantly while testing.
# Leave empty to sync globally (can take up to an hour to show up the first time).
DEV_GUILD_ID=
